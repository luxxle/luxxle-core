# LUXXLE MODIFICATION: Minimal build configuration for Chromium-based browser
import("//luxxle/build/config.gni")  # Need this for build arguments

# Keep essential Chromium imports
import("//build/config/locales.gni")
import("//build/config/zip.gni")
import("//chrome/browser/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")
import("//media/media_options.gni")
import("//third_party/icu/config.gni")
import("//third_party/widevine/cdm/widevine.gni")
import("//tools/grit/repack.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//ui/base/ui_features.gni")

if (enable_library_cdms) {
  import("//media/cdm/library_cdm/cdm_paths.gni")
}

if (is_mac) {
  import("//build/config/mac/rules.gni")
}

declare_args() {
  audit_dev_deps = true
  
  # Rust tooling
  cargo_audit_exe = "$root_out_dir/cargo-audit"  # Path to cargo audit executable
}

# This target serves as a canonical place to define all code that has to be
# buildable in all platforms in a single build run.
group("all") {
  testonly = true
  # LUXXLE MODIFICATION: Build vanilla Chromium instead of Brave
  deps = [ "//chrome" ]  # Build standard Chromium

  if (!is_android && !is_ios) {
    deps += [
      # LUXXLE: Standard Chromium tests only
      "//chrome/test:browser_tests",
      "//chrome/test:unit_tests",
      "//components:components_unittests",
      "//content/test:content_unittests",
      "//net:net_unittests",
    ]
  }
}

if (!is_ios) {
  group("child_dependencies") {
    deps = [
      "common",
      "//luxxle/renderer",
      "//luxxle/utility",
    ]
  }

  group("browser_dependencies") {
    deps = [
      "browser",
      "common",
      "//services/device/public/cpp:device_features",
    ]

    data_deps = [ ":unpacked_resources" ]

    if (!is_ios) {
      deps += [ ":packed_resources" ]
    }
  }
}

# LUXXLE: Minimal resource packing - only essential resources
group("packed_resources") {
  deps = [
    "//chrome:packed_resources",
  ]
}

group("unpacked_resources") {
  deps = [
    "//chrome:unpacked_resources",
  ]
}

# LUXXLE: Keep minimal Luxxle branding but remove Brave functionality
group("luxxle") {
  deps = [ "//chrome" ]
}

group("resources") {
  public_deps = [
    # TODO(bridiver)
    # "//luxxle/browser:resources",
    # "//luxxle/common:resources",
    # "//luxxle/renderer:resources",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/resources",
  ]

  # Commented out: removed components dependency - using Chromium defaults instead
  # data_deps = [ "//luxxle/components/resources:about_credits" ]
}

if (is_android) {
  android_assets("brave_file_assets") {
    sources = [
      "//luxxle/LICENSE.html",
      "//luxxle/android/java/org/chromium/chrome/browser/ntp/ntp_news_optin_icon_animation.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/onboarding_ads.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/onboarding_ads_notification.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/onboarding_rewards.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/privacy_protection.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/save_data_and_battery.json",
      "//luxxle/android/java/org/chromium/chrome/browser/onboarding/animations/website_loads_faster.json",
    ]
    disable_compression = false
  }

  android_assets("brave_pak_assets") {
    sources = [ "$root_out_dir/brave_resources.pak" ]

    deps = [
      "//luxxle:brave_file_assets",
      "//luxxle:packed_resources_extra",
    ]
    disable_compression = true
  }
}

if (is_mac) {
  group("framework_bundle_data") {
    deps = [
      "components/brave_extension/extension/brave_extension:brave_extension_framework_bundle_data",
      "//luxxle/build/rust:framework_exports",
    ]
  }
}

#TODO(bridiver) - what to do
if (!is_ios) {
  group("brave_tests") {
    testonly = true

    deps = [ "test:brave_unit_tests" ]

    if (!is_android) {
      deps += [
        "test:brave_browser_tests",
        "test:brave_network_audit_tests",
      ]
    }
    if (use_libfuzzer) {
      deps += [ "//luxxle/fuzzers:brave_fuzzers" ]
    }
  }
}

branding_dir = "//chrome/app/theme/$branding_path_component"
copy("theme_files") {
  visibility = [ ":*" ]
  if (is_linux) {
    sources = [
      "$branding_dir/linux/product_logo_128_beta.png",
      "$branding_dir/linux/product_logo_128_dev.png",
      "$branding_dir/linux/product_logo_128_development.png",
      "$branding_dir/linux/product_logo_128_nightly.png",
    ]
  } else {
    sources = [
      "$branding_dir/product_logo_128_beta.png",
      "$branding_dir/product_logo_128_dev.png",
      "$branding_dir/product_logo_128_development.png",
      "$branding_dir/product_logo_128_nightly.png",
    ]
  }
  outputs = [ "$root_out_dir/installer/theme/{{source_file_part}}" ]
}

