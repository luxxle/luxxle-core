# Import the original chrome_build.gni first
import("//build/config/chrome_build.gni")

# Override branding configuration for Luxxle
declare_args() {
  # Override the branding path product to use luxxle instead of chromium
  branding_path_component = "luxxle"
  branding_path_product = "luxxle"
}

# Override the branding file path
branding_file_path = "//chrome/app/theme/luxxle/BRANDING"