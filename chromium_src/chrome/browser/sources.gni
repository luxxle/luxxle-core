import("//luxxle/components/luxxle_vpn/common/buildflags/buildflags.gni")
import("//luxxle/components/text_recognition/common/buildflags/buildflags.gni")
import("//build/config/ui.gni")

luxxle_chromium_src_chrome_browser_deps = [
  "//base",
  "//luxxle/components/luxxle_vpn/common/buildflags",
  "//luxxle/components/commander/common/buildflags",
  "//luxxle/components/playlist/common/buildflags",
  "//luxxle/components/text_recognition/common/buildflags",
  "//chrome/common:channel_info",
  "//components/version_info",
]

if (!is_android) {
  luxxle_chromium_src_chrome_browser_deps += [ "//chrome/browser/ui" ]
}

if (enable_luxxle_vpn) {
  luxxle_chromium_src_chrome_browser_deps +=
      [ "//luxxle/components/luxxle_vpn/browser" ]
}

if (toolkit_views) {
  luxxle_chromium_src_chrome_browser_deps +=
      [ "//luxxle/components/sidebar/browser" ]
}
