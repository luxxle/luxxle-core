import("//luxxle/components/luxxle_vpn/common/buildflags/buildflags.gni")

luxxle_chromium_src_chrome_installer_setup_sources = []
luxxle_chromium_src_chrome_installer_setup_deps = []

if (is_win) {
  luxxle_chromium_src_chrome_installer_setup_deps += [
    "//luxxle/components/luxxle_vpn/common/buildflags",
    "//luxxle/installer/util",
    "//chrome/installer/util:work_item",
  ]

  if (enable_luxxle_vpn) {
    luxxle_chromium_src_chrome_installer_setup_deps += [
      "//luxxle/browser/luxxle_vpn/win:wireguard_utils",
      "//luxxle/browser/luxxle_vpn/win/luxxle_vpn_helper:common",
      "//luxxle/browser/luxxle_vpn/win/luxxle_vpn_wireguard_service:install_utils",
      "//luxxle/components/luxxle_vpn/browser/connection/ikev2/win:ras_utils",
    ]
  }

  if (is_official_build) {
    # These should be added to the lib target, but don't want to add another
    # patch.
    luxxle_chromium_src_chrome_installer_setup_sources += [
      "channel_override_work_item.cc",
      "channel_override_work_item.h",
    ]
  }
}
