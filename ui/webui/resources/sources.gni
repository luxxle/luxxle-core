# Extra GRDPs to give //ui/webui/resources:build_grd
# (which generates //ui/webui/resources/webui_generated_resources.grd)

luxxle_resources_extra_grdps_path = "$root_gen_dir/luxxle/ui/webui/resources"

luxxle_resources_extra_grdps = [
  "$luxxle_resources_extra_grdps_path/luxxle_fonts_resources.grdp",
  "$luxxle_resources_extra_grdps_path/luxxle_icons_resources.grdp",
  "$luxxle_resources_extra_grdps_path/luxxle_static_resources.grdp",
  "$root_gen_dir/luxxle/web-ui-leo/leo.grdp",
  "$root_gen_dir/luxxle/web-ui-opaque_ke/opaque_ke.grdp",
]

luxxle_resources_extra_grdps_deps = [ "//luxxle/ui/webui/resources:grdp" ]

# At the moment, all non-static resources are only required for polymer WebUI.
# This could change and, when it does, the `include_polymer` conditional can be removed
# here and the one in //luxxle/ui/webui/resources/BUILD.gn be relied on to only add
# polymer-related files when appropriate.
if (!is_android && !is_ios) {
  luxxle_resources_extra_grdps +=
      [ "$luxxle_resources_extra_grdps_path/resources.grdp" ]
}
