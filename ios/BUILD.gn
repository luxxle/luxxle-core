action("luxxle_core_umbrella_header") {
  script = "//build/config/ios/generate_umbrella_header.py"

  full_header_path = target_gen_dir + "/LuxxleCore.h"
  outputs = [ full_header_path ]

  args = [
    "--output-path",
    rebase_path(full_header_path, root_build_dir),
  ]

  args += rebase_path(luxxle_core_public_headers, root_build_dir)
  args += rebase_path(ios_web_view_public_headers, root_build_dir)
}

tweak_info_plist("info_plist") {
  info_plists = [ "Info.plist" ]
}

luxxle_tweak_info_plist("luxxle_core_plist") {
  info_plist = "$root_gen_dir/luxxle/ios/info_plist_tweaked.plist"

  args = [
    "--luxxle_channel=" + luxxle_channel,
    "--luxxle_version=" + luxxle_version,
    "--skip_signing",
  ]

  deps = [ ":info_plist" ]
}

ios_framework_bundle("luxxle_core_ios_framework") {
  output_name = "LuxxleCore"
  output_dir = root_out_dir

  info_plist_target = ":luxxle_core_plist"

  configs += [ ":internal_config" ]

  deps = [
    ":luxxle_core_plist",
    ":luxxle_core_umbrella_header",
    "//luxxle/ios/app",
    "//luxxle/ios/web_view",
  ]

  deps += ads_public_deps
  deps += ai_chat_public_deps
  deps += rewards_public_deps
  deps += skus_public_deps
  deps += credential_provider_public_deps
  deps += webcompat_reporter_public_deps

  sources = luxxle_core_public_headers
  sources += ios_web_view_public_headers

  public_headers = get_target_outputs(":luxxle_core_umbrella_header")
  public_headers += luxxle_core_public_headers
  public_headers += ios_web_view_public_headers
}

ios_create_xcframework("luxxle_core_xcframework") {
  framework_dir = "$root_build_dir/LuxxleCore.framework"
  remove_asset_catalogs = true
  deps = [ ":luxxle_core_ios_framework" ]
}

ios_create_xcframework("material_components_xcframework") {
  framework_dir = "$root_build_dir/MaterialComponents.framework"
  fix_info_plist_versions = true
  deps = [ "//ios/third_party/material_components_ios" ]
}

ios_create_xcframework("nala_assets_xcframework") {
  framework_dir = "$root_build_dir/NalaAssets.framework"
  deps = [ "//luxxle/ios/nala:nala_assets_framework" ]
}

# Generates an xcconfig based on GN args that are needed in the Xcode app build
# process such as Info.plist or build setting subsititions.
generated_file("generated_xcconfig") {
  outputs = [ "$root_build_dir/args.xcconfig" ]

  # Some special logic to avoid .0 patch versions in marketing versions
  ios_marketing_version = "$luxxle_version_major.$luxxle_version_minor"
  if (luxxle_ios_marketing_version_patch != 0) {
    ios_marketing_version += ".$luxxle_ios_marketing_version_patch"
  }

  contents = [
    "luxxle_version_major = $luxxle_version_major",
    "luxxle_version_minor = $luxxle_version_minor",
    "luxxle_version_build = $luxxle_version_build",
    "luxxle_ios_marketing_version = $ios_marketing_version",
    "luxxle_ios_marketing_version_patch = $luxxle_ios_marketing_version_patch",
    "luxxle_channel = $luxxle_channel",
  ]

  # If absolute paths are stripped from debug symbols ensure that SPM/Xcode
  # also maps debug symbols the same way to allow proper debugging with LLDB
  if (strip_absolute_paths_from_debug_symbols) {
    ios_dir = rebase_path("//luxxle/ios/luxxle-ios")
    ios_dir_build_relative =
        rebase_path("//luxxle/ios/luxxle-ios", root_build_dir)
    contents += [ "luxxle_ios_debug_prefix_map_flag = -debug-prefix-map $ios_dir=$ios_dir_build_relative" ]
  }

  # Set up any active compilation conditions that may be used in Swift for
  # example conditionally compiling based on `#if OFFICIAL_BUILD`
  swift_active_compliation_conditions = []
  if (is_official_build) {
    swift_active_compliation_conditions += [ "OFFICIAL_BUILD" ]
  }
  swift_active_compilation_conditions_joined =
      string_join(" ", swift_active_compliation_conditions)
  contents += [ "luxxle_swift_active_compliation_conditions = $swift_active_compilation_conditions_joined" ]
}
