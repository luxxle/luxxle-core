import("//luxxle/build/ios/mojom/mojom_wrappers.gni")
import("//build/config/ios/rules.gni")

config("external_config") {
  visibility = [ ":*" ]
  include_dirs = [ "$target_gen_dir" ]
}

source_set("ads") {
  configs += [ ":external_config" ]

  sources = [
    "ads_client_bridge.h",
    "ads_client_ios.h",
    "ads_client_ios.mm",
    "luxxle_ads.h",
    "luxxle_ads.mm",
    "inline_content_ad_ios.h",
    "inline_content_ad_ios.mm",
    "new_tab_page_ad_ios.h",
    "new_tab_page_ad_ios.mm",
    "notification_ad_ios.h",
    "notification_ad_ios.mm",
  ]

  deps = [
    ":luxxle_ads_mojom_wrappers",
    "//base",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/luxxle_ads/core",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/luxxle_news/common",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/luxxle_rewards/core",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/l10n/common",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ntp_background_images/browser",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ntp_background_images/common",
    "//luxxle/ios/browser/api/common",
    "//luxxle/ios/browser/luxxle_ads",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/prefs",
    "//ios/chrome/browser/shared/model/application_context",
    "//ios/chrome/browser/shared/model/profile",
  ]

  frameworks = [
    "Foundation.framework",
    "UIKit.framework",
    "Network.framework",
  ]
}

ios_objc_mojom_wrappers("luxxle_ads_mojom_wrappers") {
  # Commented out: removed components dependency - using Chromium defaults instead
  # mojom_target = "//luxxle/components/luxxle_ads/core/mojom"
  # Commented out: removed components dependency - using Chromium defaults instead
  # sources = [ "//luxxle/components/luxxle_ads/core/mojom/luxxle_ads.mojom" ]
  exclude_types = [
    "DBActionInfo",
    "DBBindColumnInfo",
    "DBTransactionResultInfo",
    "DBRowsUnion",
    "DBRowInfo",
    "DBTransactionInfo",
    "DBColumnValueUnion",
  ]

  # The module name is `LuxxleAds` now which matches the class we already have
  generate_namespace = false
}
