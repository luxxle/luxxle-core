import("//luxxle/build/ios/mojom/mojom_wrappers.gni")
import("//build/config/ios/rules.gni")
import("//ios/build/config.gni")

config("mojom_header_config") {
  visibility = [
    ":*",
    "//luxxle/ios/app",
  ]
  include_dirs =
      # Commented out: removed components dependency - using Chromium defaults instead
      # [ "$root_gen_dir/luxxle/components/ai_chat/core/common/mojom/ios" ]
}

source_set("ai_chat") {
  configs += [ ":mojom_header_config" ]

  sources = [
    "ai_chat+private.h",
    "ai_chat.h",
    "ai_chat.mm",
    "ai_chat_delegate.h",
    "ai_chat_service_factory.h",
    "ai_chat_service_factory.mm",
    "associated_content_driver_ios.h",
    "associated_content_driver_ios.mm",
    "conversation_client.h",
    "conversation_client.mm",
    "model_service_factory.h",
    "model_service_factory.mm",
  ]

  deps = [
    ":ai_chat_mojom_wrappers",
    "//base",
    "//luxxle/base/mac",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ai_chat/core/browser:browser",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ai_chat/core/common",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/api_request_helper",
    # Commented out: removed components dependency - using Chromium defaults instead
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/constants",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/resources:strings_grit",
    "//luxxle/ios/browser/skus",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/prefs",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/user_prefs",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/version_info",
    "//ios/chrome/browser/shared/model/application_context",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/shared/model/profile:profile_keyed_service_factory",
    "//ios/chrome/common",
    "//ios/web/public/thread",
    "//net/traffic_annotation",
    "//services/data_decoder/public/cpp",
    "//services/network/public/cpp",
    "//services/service_manager/public/cpp",
    "//ui/base",
    "//url",
  ]

  frameworks = [ "Foundation.framework" ]
}

ios_objc_mojom_wrappers("ai_chat_mojom_wrappers") {
  # Commented out: removed components dependency - using Chromium defaults instead
  # mojom_target = "//luxxle/components/ai_chat/core/common/mojom"
  sources = [
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ai_chat/core/common/mojom/ai_chat.mojom",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ai_chat/core/common/mojom/tab_tracker.mojom",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/ai_chat/core/common/mojom/untrusted_frame.mojom",
  ]
  # Commented out: removed components dependency - using Chromium defaults instead
  # output_dir = "$root_gen_dir/luxxle/components/ai_chat/core/common/mojom/ios"
  generate_namespace = false

  # These types have pending_receiver arguments which aren't
  # supported in objc_mojom_wrappers, but should be refactored to support
  # binding to them for iOS.
  exclude_types = [
    "AIChatUIHandler",
    "ChatUI",
    "ConversationEntriesState",
    "ParentUIFrame",
    "Service",
    "TabTrackerService",
    "TabDataObserver",
    "UntrustedConversationHandler",
    "UntrustedConversationUI",
    "UntrustedUIHandler",
  ]
}
