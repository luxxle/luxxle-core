template("create_dist_template") {
  action(target_name) {
    inputs = get_target_outputs(":luxxle_license_dist_resources")

    file_inputs = []
    foreach(input, inputs) {
      file_inputs += [ rebase_path(input, luxxle_dist_dir) ]
    }

    rebase_base_dir = rebase_path(luxxle_dist_dir)

    outputs = [ invoker.output ]
    rebase_output = rebase_path(invoker.output)

    dir_inputs = invoker.dir_inputs

    script = "//luxxle/script/create-dist.py"

    deps = [ ":luxxle_license_dist_resources" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    args = [
      "--base-dir=$rebase_base_dir",
      "--inputs=$file_inputs",
      "--dir-inputs=$dir_inputs",
      "--output=$rebase_output",
    ]
  }
}

if (should_generate_symbols) {
  create_dist_template("create_luxxle_symbols_dist") {
    if (is_android) {
      output = "$luxxle_dist_dir/$luxxle_product_name-v$luxxle_version-$luxxle_platform-$target_android_base-$target_cpu-symbols-$target_android_output_format.zip"
    } else {
      output = "$luxxle_dist_dir/$luxxle_product_name-v$luxxle_version-$luxxle_platform-$target_arch-symbols.zip"
    }

    deps = [ "//luxxle/app/$current_os:symbol_dist_resources" ]

    if (is_win) {
      dir_inputs = [ "$luxxle_product_name.syms" ]
    } else {
      dir_inputs = [ "$luxxle_product_name.breakpad.syms" ]
    }
  }

  if (is_mac) {
    copy("create_native_symbols_dist") {
      sources = [ "$root_out_dir/$chrome_product_full_name.dSYM.tar.bz2" ]
      outputs = [ "$luxxle_dist_dir/$luxxle_product_name-v$luxxle_version-$luxxle_platform-$target_arch-native-symbols.tar.bz2" ]

      deps = [ "//chrome:chrome_dsym_archive" ]
    }
  } else {
    group("create_native_symbols_dist") {
    }
  }
}

group("create_symbols_dist") {
  # Currently on some platforms (Android, Linux) this target generate more
  # than just symbols, so always depend on it.
  public_deps = [ "//luxxle/app/$current_os:symbol_dist_resources" ]

  if (should_generate_symbols) {
    public_deps += [
      ":create_luxxle_symbols_dist",
      ":create_native_symbols_dist",
    ]
  }
}

action("create_dist_zips") {
  output = "$luxxle_dist_dir/$luxxle_product_name-v$luxxle_version-$luxxle_platform-$target_arch.zip"
  outputs = [ output ]

  if (is_win) {
    # Repack a Chrome release archive to the luxxle format.
    # Besides changing from 7z to zip, the directory structure is a bit different.
    # TODO(atuchin): support other platforms.

    script = "//luxxle/script/repack-archive.py"
    deps = [ "//chrome/installer/mini_installer:mini_installer_archive" ]

    input = "$root_out_dir/chrome.7z"
    inputs = [ input ]

    args = [
      "--input=" + rebase_path(input),
      "--output=" + rebase_path(output),
      "--target_dir=Chrome-bin",
    ]
  } else {  # !is_win
    script = "//luxxle/script/create-dist.py"

    inputs = []
    deps = [ "app/$current_os:dist_resources" ]

    if (!is_mac) {
      inputs += get_target_outputs(":luxxle_license_dist_resources")
      deps += [ ":luxxle_license_dist_resources" ]
    }

    if (!is_mac && !is_android && !is_ios) {
      inputs += get_target_outputs(":luxxle_dist_resources")
      inputs += get_target_outputs(":luxxle_locale_dist_resources")
      if (enable_extensions) {
        foreach(locale, platform_pak_locales) {
          inputs += get_target_outputs(":luxxle_shields_locales_${locale}")
        }
      }
    }

    file_inputs = []
    foreach(input, inputs) {
      file_inputs += [ rebase_path(input, luxxle_dist_dir) ]
    }

    dir_inputs = []
    if (is_mac) {
      dir_inputs += [ luxxle_exe ]
      rebase_base_dir = rebase_path(root_out_dir)
      deps += [ "//chrome:chrome_app" ]
    } else {
      rebase_base_dir = rebase_path(luxxle_dist_dir, root_out_dir)
    }

    if (!is_mac && !is_android && !is_ios) {
      deps += [
        ":luxxle_dist_resources",
        ":luxxle_locale_dist_resources",
      ]

      if (enable_extensions) {
        deps += [ ":luxxle_extensions_locale_dist_resources" ]
      }
    }

    rebase_output = rebase_path(output)
    args = [
      "--base-dir=$rebase_base_dir",
      "--inputs=$file_inputs",
      "--dir-inputs=$dir_inputs",
      "--output=$rebase_output",
    ]
  }  # !is_win
}

