import("//luxxle/common/extensions/api/api_sources.gni")
import("//luxxle/resources/luxxle_grit.gni")
import("//tools/json_schema_compiler/json_features.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")

json_features("api_features") {
  feature_type = "APIFeature"
  method_name = "AddLuxxleAPIFeatures"
  sources = [
    "_api_features.json",
    "_luxxle_talk_api_features.json",
  ]
}

json_features("manifest_features") {
  feature_type = "ManifestFeature"
  method_name = "AddLuxxleManifestFeatures"
  sources = [ "_manifest_features.json" ]
}

json_features("behavior_features") {
  feature_type = "BehaviorFeature"
  method_name = "AddLuxxleBehaviorFeatures"
  sources = [ "_behavior_features.json" ]
}

group("extensions_features") {
  public_deps = [
    ":api_features",
    ":behavior_features",
    ":manifest_features",
    ":resources",
  ]
}

luxxle_extensions_api_deps = [
  "//chrome/common/extensions/api",
  "//extensions/common/api",
  "//skia",
]

luxxle_grit("resources") {
  source = "luxxle_api_resources.grd"
  outputs = [
    "grit/luxxle_api_resources.h",
    "luxxle_api_resources.pak",
  ]
}

generated_json_strings("generated_api_json_strings") {
  sources = luxxle_extensions_api_schema_sources +
            luxxle_extensions_api_uncompiled_sources

  configs = [ "//build/config:precompiled_headers" ]
  bundle_name = "Luxxle"
  schema_include_rules = luxxle_extensions_api_schema_include_rules

  root_namespace = luxxle_extensions_api_root_namespace
  deps = luxxle_extensions_api_deps

  visibility = [ ":api" ]
}

generated_types("generated_api_types") {
  sources = luxxle_extensions_api_schema_sources
  configs = [ "//build/config:precompiled_headers" ]
  schema_include_rules = luxxle_extensions_api_schema_include_rules

  root_namespace = luxxle_extensions_api_root_namespace
  deps = luxxle_extensions_api_deps
  visibility = [ ":api" ]
}

# Public Targets

group("api") {
  public_deps = [
    ":generated_api_json_strings",
    ":generated_api_types",
  ]
}
