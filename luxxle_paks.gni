import("//build/config/locales.gni")
import("//tools/grit/repack.gni")

assert(!is_ios)

# Minimal template for Luxxle paks - simplified version for minimal browser
template("luxxle_paks") {
  # Acknowledge parameters we don't use in minimal implementation
  not_needed(invoker, [ "output_dir", "copy_data_to_bundle" ])
  
  # For now, just create a minimal group that satisfies the dependency
  # Most Luxxle-specific resources are disabled in the minimal config
  group(target_name) {
    forward_variables_from(invoker, [ "deps" ])
    
    # Minimal dependencies - just what's needed for basic browser functionality
    public_deps = []
    
    if (defined(invoker.public_deps)) {
      public_deps += invoker.public_deps
    }
  }
}