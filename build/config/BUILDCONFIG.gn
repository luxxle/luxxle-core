# Import base Chromium configuration
import("//build/config/BUILDCONFIG.gn")

# Add Luxxle-specific compiler flags
if (!is_redirect_cc_build) {
  _luxxle_include = rebase_path("//luxxle/chromium_src", root_build_dir)
  compiler_defaults = {
    forward_variables_from(default_compiler_configs, "*")
    common_compiler_flags = [ "-I" + _luxxle_include ]
  }
} 