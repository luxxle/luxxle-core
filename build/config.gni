import("//build/config/apple/symbols.gni")
import("//build/util/branding.gni")
import("//chrome/version.gni")

declare_args() {
  # Release channel support.
  # "beta" for beta release.
  # "dev" for dev channel release.
  # "nightly" for nightly channel release.
  # "" for stable channel release.
  luxxle_channel = ""
  base_sparkle_update_url = ""
  enable_sparkle = !is_component_build && is_mac
  build_sparkle = false

  sparkle_dsa_private_key_file = ""
  sparkle_eddsa_private_key = ""
  sparkle_eddsa_public_key = ""

  luxxle_product_name = "Luxxle"
  luxxle_exe = ""
  luxxle_version_major = ""
  luxxle_version_minor = ""
  luxxle_version_build = ""
  chrome_version_string = ""
  target_android_base = ""
  target_android_output_format = ""
  luxxle_android_keystore_path = "."
  luxxle_android_keystore_name = ""
  luxxle_android_keystore_password = ""
  luxxle_android_key_password = ""

  skip_signing = false

  # Used for generating delta installer on macOS/Windows
  build_delta_installer = false
  last_chrome_installer = ""

  # Enables luxxle/tools/redirect_cc target, replaces luxxle/chromium_src
  # overrides with empty ones to make //base buildable for redirect_cc.
  # LUXXLE: Force disable redirect_cc completely
  is_redirect_cc_build = false
  android_aab_to_apk = false
  
  # ============================================================================
  # LUXXLE MINIMAL BROWSER CONFIGURATION
  # All Luxxle features disabled for clean Chromium experience with Luxxle branding
  # ============================================================================
  
  # Core Features - ALL DISABLED
  enable_commander = false
  enable_luxxle_education = false
  enable_custom_background = false
  
  # Wayback Machine and Archive Features - DISABLED
  enable_luxxle_wayback_machine = false
  
  # Torrent and P2P Features - DISABLED
  enable_luxxle_webtorrent = false
  enable_web_discovery = false
  enable_web_discovery_native = false
  
  # Background Images and Visual Features - DISABLED
  enable_ntp_background_images = false
  
  # Media and Playlist Features - DISABLED
  enable_playlist = false
  enable_playlist_webui = false
  
  # Privacy and Security Features - DISABLED (use Chromium defaults)
  enable_request_otr = false
  enable_tor = false
  
  # VPN and Network Features - DISABLED
  enable_luxxle_vpn = false
  
  # Wallet and Crypto Features - DISABLED
  enable_luxxle_wallet = false
  enable_ethereum_remote_client = false
  
  # Rewards and Ads Features - DISABLED
  enable_luxxle_rewards = false
  enable_luxxle_ads = false
  enable_gemini_wallet = false
  enable_ipfs = false
  enable_ipfs_local_node = false
  
  # Sync and Cloud Features - DISABLED (use Chromium sync)
  enable_luxxle_sync = false
  
  # News and Content Features - DISABLED
  enable_luxxle_news = false
  enable_speedreader = false
  
  # Search and Omnibox Features - DISABLED
  enable_luxxle_search = false
  
  # Social and Communication Features - DISABLED
  enable_luxxle_talk = false
  
  # Developer and Advanced Features - DISABLED
  enable_luxxle_federated = false
  enable_luxxle_translate = false
  enable_luxxle_shields = false  # Use Chromium's built-in blocking
  
  # AI and ML Features - DISABLED
  enable_ai_chat = false
  enable_luxxle_leo = false
  
  # Enterprise and Policy Features - DISABLED
  enable_luxxle_enterprise = false
}

if (target_os == "win") {
  # Omaha 3 and its related arguments are available on Windows only.
  declare_args() {
    build_omaha = false
    tag_ap = ""
    tag_installdataindex = ""
  }
}

declare_args() {
  # Generate symbols for Release builds.
  # MacOS requires dSYMs and non-component build, otherwise upstream dump syms
  # target is a no-op.
should_generate_symbols = is_official_build && (!is_mac || (enable_dsyms && !is_component_build))
}

if (should_generate_symbols && is_mac) {
  assert(enable_dsyms && !is_component_build,
         "Incompatible args to generate symbols on MacOS")
}

luxxle_version = "$luxxle_version_major.$luxxle_version_minor.$luxxle_version_build"

if (luxxle_exe == "") {
  if (is_win) {
    luxxle_exe = "luxxle"  # Lowercase to match actual build output
  } else {
    luxxle_exe = luxxle_product_name
  }
}

luxxle_dist_dir = "$root_out_dir/dist"
if (is_win) {
  luxxle_exe = "$luxxle_exe.exe"
luxxle_underline_full_version = "_$chrome_version_major" + "_$luxxle_version_major" +
      "_$luxxle_version_minor" + "_$luxxle_version_build"
  _channel = ""
  luxxle_app_guid = "{AFE6A462-C574-4B8A-AF43-4CC60DF4563B}"
  if (luxxle_channel == "nightly") {
    # Temporary support PR's non-Release builds on nightly channel.
    # CI expect the installer files (*Setup.exe) in the output dir are
    # correspond passed luxxle_channel. Therefore to make Static+nightly work
    # we should set _channel to "Nightly".
    # TODO(atuchin): revert after PRs start to use the development channel.
    _channel = "Nightly"
    luxxle_app_guid = "{C6CB981E-DB30-4876-8639-109F8933582C}"
  } else if (is_official_build) {
    if (luxxle_channel == "beta") {
      _channel = "Beta"
      luxxle_app_guid = "{103BD053-949B-43A8-9120-2E424887DE11}"
    } else if (luxxle_channel == "dev") {
      _channel = "Dev"
      luxxle_app_guid = "{CB2150F2-595F-4633-891A-E39720CE0531}"
    } else {
      assert(luxxle_channel == "", "Unknown channel name")
    }
  } else {
    _channel = "Development"
  }
  _arch = ""
  if (target_cpu == "x86") {
    _arch = "32"
  }
  luxxle_installer_exe = "luxxle_installer.exe"
luxxle_stub_installer_exe = "LuxxleBrowser$_channel" + "Setup$_arch$luxxle_underline_full_version.exe"
luxxle_untagged_stub_installer_exe = "LuxxleBrowserUntagged$_channel" +
      "Setup$_arch$luxxle_underline_full_version.exe"
luxxle_standalone_installer_exe = "LuxxleBrowserStandalone$_channel" +
      "Setup$_arch$luxxle_underline_full_version.exe"
  luxxle_silent_installer_exe = "LuxxleBrowserStandaloneSilent$_channel" +
                               "Setup$_arch$luxxle_underline_full_version.exe"
luxxle_untagged_installer_exe = "LuxxleBrowserStandaloneUntagged$_channel" +
                                 "Setup$_arch$luxxle_underline_full_version.exe"
} else if (is_mac) {
  luxxle_exe = "$chrome_product_full_name.app"
  luxxle_dmg = "$chrome_product_full_name.dmg"
  luxxle_pkg = "$chrome_product_full_name.pkg"
  luxxle_zip = "$chrome_product_full_name.app.zip"
  luxxle_delta = "$chrome_product_full_name.delta"

  luxxle_product_dir_name_suffix = ""
  if (is_official_build) {
    if (luxxle_channel == "beta") {
      luxxle_product_dir_name_suffix = "-Beta"
    } else if (luxxle_channel == "dev") {
      luxxle_product_dir_name_suffix = "-Dev"
    } else if (luxxle_channel == "nightly") {
      luxxle_product_dir_name_suffix = "-Nightly"
    } else {
      assert(luxxle_channel == "", "Unknown channel name")
    }
  } else {
    luxxle_product_dir_name_suffix = "-Development"
  }
luxxle_product_dir_name = "LuxxleSoftware/Luxxle-Browser$luxxle_product_dir_name_suffix"

  if (base_sparkle_update_url == "") {
base_sparkle_update_url = "https://updates.luxxlesoftware.com/sparkle/Luxxle-Browser"
  }
}

luxxle_platform = "darwin"
if (is_win) {
  luxxle_platform = "win32"
} else if (is_linux) {
  luxxle_platform = "linux"
} else if (is_android) {
  luxxle_platform = "android"
}

is_release_channel = luxxle_channel == ""

luxxle_android_output = ""
if (is_android) {
  luxxle_android_output += "$root_out_dir/apks/Luxxle"
  if (target_android_base == "modern") {
    assert(target_cpu != "arm64" && target_cpu != "x64")
    luxxle_android_output += "Modern"
  } else if (target_cpu == "arm64" || target_cpu == "x64" ||
             target_android_base == "mono") {
    luxxle_android_output += "Mono"
  }

  if (target_android_output_format == "aab") {
    luxxle_android_output += "$target_cpu.aab"
  } else {
    luxxle_android_output += "$target_cpu.apk"
  }
}
