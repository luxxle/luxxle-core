# To use our overrided enum in java, put the header file of our overrided enum
# in luxxle_android_java_enums_srcjar target and add the chromium header file of
# the enum we're replacing in luxxle_java_cpp_enum_filter.
luxxle_java_cpp_enum_filter = [ "//chrome/browser/notifications/notification_handler.h" ]
luxxle_chrome_java_srcjar_deps = [
  "//luxxle/android:luxxle_android_java_enums_srcjar",
  "//luxxle/android:luxxle_config_java",
