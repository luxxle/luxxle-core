# Commented out: removed components dependency - using Chromium defaults instead
import("sign.gni")

group("luxxle") {
  public_deps = [
    ":copy_exe",
    ":copy_pdb",
  ]
  deps = [
  ]
}

copy("copy_exe") {
  sources = [ "$root_out_dir/chrome.exe" ]

  outputs = [ "$root_out_dir/luxxle.exe" ]

  deps = [ "//chrome:reorder_imports" ]
}

copy("copy_pdb") {
  sources = [ "$root_out_dir/chrome.exe.pdb" ]

  outputs = [ "$root_out_dir/luxxle.exe.pdb" ]

  deps = [ "//chrome:reorder_imports" ]
}

# Basic installer target to satisfy build dependencies
group("create_signed_installer") {
  # This is a placeholder target to satisfy the dependency chain
  # Full installer functionality can be added later
  deps = [ ":luxxle" ]
}
