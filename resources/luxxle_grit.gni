import("//tools/grit/grit_rule.gni")

luxxle_grit_resource_id_target = "//luxxle/resources:luxxle_resource_ids"
luxxle_grit_resource_id_file = get_label_info(luxxle_grit_resource_id_target, "target_gen_dir") +
    "/luxxle_resource_ids"

template("luxxle_grit") {
  grit(target_name) {
    forward_variables_from(invoker, "*")
    resource_ids = luxxle_grit_resource_id_file
    if (!defined(deps)) {
      deps = []
    }
    deps += [ luxxle_grit_resource_id_target ]
  }
}

template("luxxle_or_default_grit") {
  if (defined(invoker.use_luxxle_grit) && invoker.use_luxxle_grit) {
    luxxle_grit(target_name) {
      forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY)
    }
  } else {
    grit(target_name) {
      forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY)
    }
  }
}
