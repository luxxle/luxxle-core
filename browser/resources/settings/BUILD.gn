preprocess_folder = "preprocessed"

# grit (and generate the GRD for) luxxle's own static resources, they don't need
# to be part of the build_webui.gni compile.
# TODO(petemill): It is no longer neccessary to make our own grd and pak, we can add to
# chromium's static_files list.
luxxle_grit("resources") {
  defines = chrome_grit_defines
  defines += [
    "is_release_channel=$is_release_channel",
    "enable_tor=$enable_tor",
  ]

  enable_input_discovery_for_gn_analyze = false
  source = "$target_gen_dir/luxxle_settings_resources.grd"
  deps = [ ":build_grd" ]

  outputs = [
    "grit/luxxle_settings_resources.h",
    "grit/luxxle_settings_resources_map.cc",
    "grit/luxxle_settings_resources_map.h",
    "luxxle_settings_resources.pak",
  ]
}

generate_grd("build_grd") {
  grd_prefix = "luxxle_settings"
  out_grd = "$target_gen_dir/${grd_prefix}_resources.grd"
  input_files = [
    "luxxle_sync_page/device_computer.svg",
    "luxxle_sync_page/device_mobile.svg",
    "luxxle_sync_page/qr_scanning.svg",
    "luxxle_sync_page/start_icon.svg",
    "images/cookies_banner.svg",
    "images/cookies_banner_dark.svg",
    "images/full_luxxle_brand.svg",
    "images/full_luxxle_brand_dark.svg",
    "images/permissions_banner.svg",
    "images/permissions_banner_dark.svg",
    "images/safe_browsing_banner.svg",
    "images/safe_browsing_banner_dark.svg",
    "images/warning_triangle.svg",
  ]
  input_files_base_dir = rebase_path(".", "//")

  # Commented out: grdp files for removed UI components
  # grdp_files = [ "$root_gen_dir/luxxle/web-ui-email_aliases/email_aliases.grdp" ]

  deps = [
    ":preprocess",
    # Commented out: dependencies on removed UI components
    # "email_aliases_page:email_aliases_ui",
  ]

  # Commented out: commands UI removed for minimal build
  # if (!is_android) {
  #   grdp_files += [ "$root_gen_dir/luxxle/web-ui-commands/commands.grdp" ]
  #   deps += [ "shortcuts_page:commands_ui" ]
  # }
}

# Move luxxle files to the place where chromium settings page is compiled from.
# It should be the same directory that build_webui.gni uses after it performs
# its own preprocess_if_expr. Once chromium and luxxle frontend files are all in
# the same place, build_webui.gni will continue its typescript and rollup
# compile (etc.) from that directory.
preprocess_if_expr("preprocess") {
  defines = [
    # Commented out: components disabled for Luxxle
    # "enable_tor=$enable_tor",
    "enable_extensions=$enable_extensions",
    "enable_pin_shortcut=$enable_pin_shortcut",
    # "enable_web_discovery_native=$enable_web_discovery_native",
  ]
  out_folder =
      "$root_gen_dir/chrome/browser/resources/settings/$preprocess_folder"

  in_files = luxxle_settings_local_ts_files + luxxle_settings_local_html_files +
             luxxle_settings_local_css_files
}
