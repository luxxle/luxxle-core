import("//luxxle/browser/shell_integrations/buildflags/buildflags.gni")
import("//chrome/browser/resources/settings/settings.gni")

settings_namespace_rewrites = [
  "settings.LuxxleAppearanceBrowserProxyImpl|LuxxleAppearanceBrowserProxyImpl",
  "settings.LuxxleLeoAssistantBrowserProxyImpl|LuxxleLeoAssistantBrowserProxyImpl",
  "settings.LuxxleVPNBrowserProxyImpl|LuxxleVPNBrowserProxyImpl",
  "settings.LuxxleWalletBrowserProxyImpl|LuxxleWalletBrowserProxyImpl",
  "settings.LuxxleDefaultExtensionsBrowserProxyImpl|LuxxleDefaultExtensionsBrowserProxyImpl",
  "settings.LuxxleNewTabBrowserProxyImpl|LuxxleNewTabBrowserProxyImpl",
  "settings.LuxxlePrivacyBrowserProxyImpl|LuxxlePrivacyBrowserProxyImpl",
  "settings.LuxxleRewardsBrowserProxyImpl|LuxxleRewardsBrowserProxyImpl",
  "settings.LuxxleSearchEnginesPageBrowserProxyImpl|LuxxleSearchEnginesPageBrowserProxyImpl",
  "settings.LuxxleSyncBrowserProxy|LuxxleSyncBrowserProxy",
  "settings.DefaultLuxxleShieldsBrowserProxyImpl|DefaultLuxxleShieldsBrowserProxyImpl",
  "settings.SocialBlockingPageProxyImpl|SocialBlockingPageProxyImpl",
  "settings.Router|Router",
]

if (enable_pin_shortcut) {
  settings_namespace_rewrites += [
    "settings.PinShortcutPageBrowserProxyImpl|PinShortcutPageBrowserProxyImpl",
  ]
}

settings_auto_imports = [ "chrome/browser/resources/settings/router.html|Router,Route" ]
