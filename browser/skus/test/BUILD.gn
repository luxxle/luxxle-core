source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "js_skus_api_browsertest.cc" ]

  deps = [
    "//base/test:test_support",
    "//luxxle/browser",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/skus/browser",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/skus/common",
    "//chrome/browser:browser_process",
    "//chrome/test:test_support",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/prefs",
    "//content/public/common",
    "//content/test:test_support",
    "//net:test_support",
    "//services/network/public/cpp",
  ]

  if (is_android) {
    deps += [ "//chrome/test:test_support_ui_android" ]
  } else {
    deps += [ "//chrome/test:test_support_ui" ]
  }
}
