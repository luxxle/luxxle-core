import("//luxxle/build/config.gni")
import("//testing/test.gni")

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "variations_browsertest.cc" ]

  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/test:test_support",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/variations",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/variations:test_support",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//components/variations/service",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

source_set("brave_metrics_unit_tests") {
  testonly = true

  sources = [
    "enabled_state_provider_unittest.cc",
    "metrics_reporting_util_unittest.cc",
  ]
  deps = [
    "//base/test:test_support",
    "//luxxle/browser",
    "//luxxle/browser/metrics/buildflags",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//content/test:test_support",
  ]

  if (is_linux) {
    sources += [ "metrics_reporting_util_unittest_linux.cc" ]
    configs += [ "//luxxle/build/linux:linux_channel_names" ]

    deps += [
      "//chrome/common:channel_info",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//components/version_info:channel",
    ]
  }
}
