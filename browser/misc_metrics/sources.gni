  # "//components/keyed_service/content",
  # Commented out: removed components dependency - using Chromium defaults instead
  # "//components/keyed_service/core",
  "//content/public/browser",
]

if (!is_android) {
  luxxle_browser_misc_metrics_sources += [
    "//luxxle/browser/misc_metrics/profile_new_tab_metrics.cc",
    "//luxxle/browser/misc_metrics/profile_new_tab_metrics.h",
  ]

  luxxle_browser_misc_metrics_deps +=
      [ "//luxxle/browser/misc_metrics:usage_clock" ]
}

