      # Commented out: removed components dependency - using Chromium defaults instead
      # "//luxxle/components/l10n/common:test_support",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//luxxle/components/ntp_background_images/common",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//components/policy/core/browser",
