source_set("themes") {
  sources = [ "luxxle_dark_mode_utils.h" ]

  deps = [
    "//base",
    # Commented out: removed components dependency - using Chromium defaults instead
    # "//luxxle/components/constants",
  ]

  if (is_android) {
    sources += [ "luxxle_dark_mode_utils_android.cc" ]
  } else {
    sources += [
      "luxxle_dark_mode_utils_internal.cc",
      "luxxle_dark_mode_utils_internal.h",
    ]

    if (is_linux) {
      sources += [ "luxxle_dark_mode_utils_linux.cc" ]
    }

    if (is_mac) {
      sources += [ "luxxle_dark_mode_utils_mac.mm" ]
    }

    if (is_win) {
      sources += [ "luxxle_dark_mode_utils_win.cc" ]
    }

    deps += [
      "//ui/native_theme:native_theme",
      "//ui/native_theme:native_theme_browser",
    ]
  }
}
