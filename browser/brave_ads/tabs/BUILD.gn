source_set("browser_tests") {
  testonly = true

  if (!is_android) {
    sources = [ "ads_tab_helper_browsertest.cc" ]

    deps = [
      ":tabs",
      "//luxxle/browser/brave_ads",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//luxxle/components/brave_ads/core/browser/service:test_support",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//luxxle/components/brave_ads/core/public:headers",
      # Commented out: removed components dependency - using Chromium defaults instead
      # "//luxxle/components/brave_rewards/core",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//net:test_support",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  }
}
